{
  "version": 1,
  "reviewRules": [
    {"flag":"immediate_safety_concern","concern":{"urgency":["immediate_danger"]}},
    {"flag":"time_sensitive","concern":{"urgency":["time_sensitive"]}},
    {"flag":"time_sensitive","state":"MN","office":"managed_care","details":{"urgentService":["yes"]}},
    {"flag":"routing_review","office":"triage"},
    {"flag":"routing_review","state":"WI","office":"wi_boaltc","details":{"ageBand":["under_60","unknown"]}},
    {"flag":"routing_review","state":"WI","office":"wi_boaltc","details":{"setting":["other","unknown"]}},
    {"flag":"routing_review","state":"MN","office":"managed_care","details":{"program":["other"]}},
    {"flag":"routing_review","differentSuggestedOffice":true},
    {"flag":"facility_notice_review","state":"MN","office":"ooltc","details":{"topic":["notice"]}},
    {"flag":"incident_report_review","state":"MN","office":"omhdd","details":{"topic":["incident"]}},
    {"flag":"appeal_review","state":"MN","office":"managed_care","details":{"topic":["benefit_decision"]}}
  ],
  "concernFields": [
    {"key":"relationship","label":"Who is the concern about?","type":"select","required":true,"options":[{"value":"self","label":"Me"},{"value":"family_or_friend","label":"A family member or someone I support"},{"value":"representative","label":"Someone I formally represent"},{"value":"provider","label":"Someone my organization serves"},{"value":"systemic","label":"Multiple people or a broader issue"},{"value":"other","label":"Someone else"}]},
    {"key":"subjectName","label":"Name of the person affected","type":"text","max":120,"when":{"relationship":["family_or_friend","representative","provider","other"]}},
    {"key":"summary","label":"What happened?","type":"textarea","max":3000,"required":true,"help":"Describe the concern and include any important dates you know."},
    {"key":"desiredOutcome","label":"What would help resolve the concern?","type":"textarea","max":1500,"rows":2},
    {"key":"urgency","label":"Is there a safety concern or a deadline?","type":"radio","required":true,"options":[{"value":"immediate_danger","label":"Someone is in immediate danger"},{"value":"time_sensitive","label":"There is a deadline or urgent concern"},{"value":"routine","label":"No known deadline or urgent concern"},{"value":"unknown","label":"Not sure"}]},
    {"key":"urgentDetails","label":"What needs attention soon?","type":"textarea","max":1000,"rows":2,"help":"Include a known deadline or planned event, if applicable.","when":{"urgency":["time_sensitive"]}}
  ],
  "contactFields": [
    {"key":"contactMethod","label":"Safe way to follow up","type":"radio","required":true,"options":[{"value":"phone","label":"Phone"},{"value":"email","label":"Email"},{"value":"none","label":"No follow-up requested"},{"value":"unknown","label":"Safe contact method unknown"}]},
    {"key":"phone","label":"Phone number","type":"tel","max":45,"required":true,"when":{"contactMethod":["phone"]}},
    {"key":"voicemail","label":"Is it safe to leave a voicemail?","type":"radio","options":[{"value":"yes","label":"Yes"},{"value":"no","label":"No"}],"when":{"contactMethod":["phone"]}},
    {"key":"email","label":"Email address","type":"email","max":254,"required":true,"when":{"contactMethod":["email"]}},
    {"key":"receivedVia","label":"How the concern came in","type":"select","options":[{"value":"phone","label":"Phone"},{"value":"email","label":"Email"},{"value":"fax","label":"Fax"},{"value":"mail","label":"Mail"},{"value":"web","label":"Online form"},{"value":"partner","label":"Partner referral"},{"value":"in_person","label":"In person"},{"value":"other","label":"Other"}]},
    {"key":"contactName","label":"Reporter’s name","type":"text","max":120,"additional":true},
    {"key":"contactNotes","label":"Safe times or contact instructions","type":"text","max":240,"additional":true,"when":{"contactMethod":["phone","email"]}},
    {"key":"accessNeeds","label":"Language or accessibility needs","type":"text","max":240,"additional":true,"help":"For example, an interpreter, relay service, or accessible documents."},
    {"key":"receivedAtCentral","label":"When the concern came in","type":"datetime-local","additional":true,"help":"Enter the date and time where the concern was received."}
  ]
}
